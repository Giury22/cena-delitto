# Copia questo file in .env e configura l'account organizzatore.
ADMIN_FIRST_NAME=
ADMIN_LAST_NAME=
ADMIN_PASSWORD=
PORT=3000
HOST=0.0.0.0

# Su Netlify: imposta queste variabili dalla dashboard, con ambito Functions.
# Token fine-grained, limitato alla sola repository, Contents: Read and write.
GITHUB_TOKEN=
GITHUB_REPOSITORY=tuo-utente/nome-repository
GITHUB_DATA_BRANCH=main
# Facoltativo: segreto lungo per firmare le sessioni. Altrimenti si usa ADMIN_PASSWORD.
SESSION_SECRET=
